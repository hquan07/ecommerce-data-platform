POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce
POSTGRES_DB=ecommerce
POSTGRES_PORT=5432

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

KAFKA_BROKER=kafka:9092
KAFKA_TOPIC=order-events

AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow

# CloudVault project client (keep the real token only in local .env/secrets)
CLOUDVAULT_BASE_URL=http://cloudvault-api
CLOUDVAULT_PROJECT_ID=ecommerce
CLOUDVAULT_SERVICE_TOKEN=
CLOUDVAULT_CONNECT_TIMEOUT_SECONDS=5
CLOUDVAULT_READ_TIMEOUT_SECONDS=60
CLOUDVAULT_MAX_RETRIES=3
CLOUDVAULT_RETRY_BASE_SECONDS=0.5
CLOUDVAULT_MAX_FILE_BYTES=104857600
